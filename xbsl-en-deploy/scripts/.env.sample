# Console API access for deploying an Element application.
# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# Base URL of the management/console API.
ELEMENT_BASE_URL=https://1cmycloud.com

# Console API client credentials (issued in the management console).
ELEMENT_CLIENT_ID=
ELEMENT_CLIENT_SECRET=

# Target project and application ids.
ELEMENT_PROJECT_ID=
ELEMENT_APP_ID=

# Path A only: the platform branch id to sync (platform-side git pull).
ELEMENT_BRANCH_ID=

# Optional build metadata / targeting.
ELEMENT_SPACE_ID=
# LAST_BUILD_VERSION=1.0-42
