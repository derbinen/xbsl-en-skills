# Console API access for deploying an Element application.
# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# The console host.
ELEMENT_BASE_URL=https://1cmycloud.com

# The access key of the console (profile -> access keys).
ELEMENT_CLIENT_ID=
ELEMENT_CLIENT_SECRET=

# The console project the builds go to, and the application to update.
ELEMENT_PROJECT_ID=
ELEMENT_APP_ID=
